@page
@model RegisterModel
@{
    Layout = "/Areas/Identity/Pages/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Create Account";
}

<div class="min-h-screen flex items-center justify-center px-4">
    <div class="w-full max-w-md bg-[#0f0f10]/90 backdrop-blur-md border border-[#1f1f1f] rounded-2xl shadow-glow p-8 text-gray-200">

        <div class="text-center mb-6">
            <a asp-controller="Home" asp-action="Index" class="inline-flex items-center justify-center gap-1">
                <span class="text-3xl font-extrabold tracking-tight">
                    <span class="text-blue-500">Apex</span><span class="text-gray-100">Drive</span>
                </span>
            </a>
            <p class="mt-3 text-sm text-gray-400">Join us — luxury rides await you.</p>
        </div>

        <form id="registerForm"
              asp-route-returnUrl="@Model.ReturnUrl"
              method="post"
              class="space-y-5">

            <div asp-validation-summary="ModelOnly"
                 class="text-red-500 text-sm"
                 role="alert"></div>

            <!-- Email -->
            <div>
                <label asp-for="Input.Email" class="block text-sm font-medium text-gray-300">Email</label>
                <input asp-for="Input.Email"
                       class="mt-1 w-full rounded-xl border border-[#2d2d2d] bg-[#151515] text-gray-100 px-4 py-2 text-sm"
                       placeholder="name@example.com"
                       autocomplete="username" />
                <span asp-validation-for="Input.Email" class="text-red-500 text-xs"></span>
            </div>

            <!-- Password -->
            <div>
                <label asp-for="Input.Password" class="block text-sm font-medium text-gray-300">Password</label>
                <input asp-for="Input.Password"
                       class="mt-1 w-full rounded-xl border border-[#2d2d2d] bg-[#151515] text-gray-100 px-4 py-2 text-sm"
                       placeholder="••••••"
                       autocomplete="new-password" />
                <span asp-validation-for="Input.Password" class="text-red-500 text-xs"></span>
            </div>

            <!-- Confirm Password -->
            <div>
                <label asp-for="Input.ConfirmPassword" class="block text-sm font-medium text-gray-300">
                    Confirm Password
                </label>
                <input asp-for="Input.ConfirmPassword"
                       class="mt-1 w-full rounded-xl border border-[#2d2d2d] bg-[#151515] text-gray-100 px-4 py-2 text-sm"
                       placeholder="••••••"
                       autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-red-500 text-xs"></span>
            </div>

            <div class="py-2">
                <div class="flex justify-center p-4 bg-slate-50/50 rounded-2xl border border-slate-200 shadow-sm backdrop-blur-sm">
                    <div class="cf-turnstile"
                         data-sitekey="@Model.TurnstileSiteKey"
                         data-theme="light"
                         data-size="flexible"></div>
                </div>
            </div>

            <button type="submit"
                    class="w-full rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold px-4 py-2 shadow-md transition">
                Create Account
            </button>

            <div class="mt-5 text-sm text-center space-y-1">
                <p>
                    Already have an account?
                    <a asp-page="./Login"
                       asp-route-returnUrl="@Model.ReturnUrl"
                       class="text-blue-400 hover:underline font-medium">
                        Sign in
                    </a>
                </p>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
}
